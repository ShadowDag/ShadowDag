[Unit]
Description=ShadowDAG testnet miner liveness watchdog (docker: shadowdag-testnet)
After=docker.service
Requires=docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/shadowdag-testnet-miner-watchdog.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shadowdag-testnet-miner

[Install]
WantedBy=multi-user.target
